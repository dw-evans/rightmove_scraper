// download this file from the gmail api after setup of a google developer application
// Cant remember exactly what to do - but you need to setup oauth2
// remember to add the desired emails to give access without needing to register the app - as this needs permission to "send emails on your behalf"
{
    "installed": {
        "client_id": "A LONG STRING OF CHARACTERS HERE.apps.googleusercontent.com",
        "project_id": "PROJECT ID WILL BE HERE",
        "auth_uri": "https://accounts.google.com/o/oauth2/auth",
        "token_uri": "https://oauth2.googleapis.com/token",
        "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
        "client_secret": "SECRET WILL BE HERE",
        "redirect_uris": [
            "http://localhost"
        ]
    }
}